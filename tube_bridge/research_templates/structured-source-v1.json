{
  "template_id": "structured-source-v1",
  "template_version": 1,
  "description": "Machine-prefilled video and transcript source record with agent-filled metadata annotation and internal content structure.",
  "target_types": ["video"],
  "field_ownership": {
    "machine_fields": "tube_bridge_read_only",
    "agent_fields": "user_or_agent_editable"
  },
  "agent_fields": {
    "metadata_annotation": {
      "completion": "unfilled",
      "summary": null,
      "tags": [],
      "custom_fields": {}
    },
    "content_structure": {
      "completion": "unfilled",
      "root_title": null,
      "root_tags": [],
      "sections": [],
      "custom_fields": {}
    },
    "source_annotation": {
      "completion": "unfilled",
      "media_market": null,
      "organization_type": null,
      "video_format": null,
      "source_role": null,
      "confidence": "unknown",
      "evidence_refs": [],
      "custom_fields": {}
    }
  },
  "agent_fields_schema": {
    "type": "object",
    "additionalProperties": false,
    "$defs": {
      "source_ref": {
        "type": "object",
        "additionalProperties": false,
        "required": ["video_id", "transcript_version_id", "first_segment_id", "last_segment_id", "start_ms", "end_ms"],
        "properties": {
          "video_id": {"type": "string", "minLength": 1},
          "transcript_version_id": {"type": "string", "minLength": 1},
          "first_segment_id": {"type": "string", "minLength": 1},
          "last_segment_id": {"type": "string", "minLength": 1},
          "start_ms": {"type": "integer", "minimum": 0},
          "end_ms": {"type": "integer", "minimum": 0}
        }
      }
    },
    "required": ["metadata_annotation", "content_structure", "source_annotation"],
    "properties": {
      "metadata_annotation": {
        "type": "object",
        "additionalProperties": false,
        "required": ["completion", "summary", "tags", "custom_fields"],
        "properties": {
          "completion": {"enum": ["unfilled", "draft", "complete"]},
          "summary": {"type": ["string", "null"]},
          "tags": {"type": "array", "items": {"type": "string"}},
          "custom_fields": {"type": "object"}
        }
      },
      "content_structure": {
        "type": "object",
        "additionalProperties": false,
        "required": ["completion", "root_title", "root_tags", "sections", "custom_fields"],
        "properties": {
          "completion": {"enum": ["unfilled", "draft", "complete"]},
          "root_title": {"type": ["string", "null"]},
          "root_tags": {"type": "array", "items": {"type": "string"}},
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["section_id", "ordinal", "title", "first_segment_id", "last_segment_id", "start_ms", "end_ms", "tags", "notes"],
              "properties": {
                "section_id": {"type": "string", "minLength": 1},
                "ordinal": {"type": "integer", "minimum": 0},
                "title": {"type": "string"},
                "first_segment_id": {"type": "string"},
                "last_segment_id": {"type": "string"},
                "start_ms": {"type": "integer", "minimum": 0},
                "end_ms": {"type": "integer", "minimum": 0},
                "tags": {"type": "array", "items": {"type": "string"}},
                "notes": {"type": ["string", "null"]}
              }
            }
          },
          "custom_fields": {"type": "object"}
        }
      },
      "source_annotation": {
        "type": "object",
        "additionalProperties": false,
        "required": ["completion", "media_market", "organization_type", "video_format", "source_role", "confidence", "evidence_refs", "custom_fields"],
        "properties": {
          "completion": {"enum": ["unfilled", "draft", "complete"]},
          "media_market": {"type": ["string", "null"]},
          "organization_type": {"type": ["string", "null"]},
          "video_format": {"type": ["string", "null"]},
          "source_role": {"type": ["string", "null"]},
          "confidence": {"enum": ["unknown", "low", "medium", "high"]},
          "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/source_ref"}},
          "custom_fields": {"type": "object"}
        }
      }
    }
  }
}
